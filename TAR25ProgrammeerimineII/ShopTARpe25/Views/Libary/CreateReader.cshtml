@model ShopTARpe25.Core.Dto.ReaderDto

<h2>Lisa lugeja</h2>
<form asp-action="CreateReader" method="post">
    <p><input asp-for="FullName" placeholder="Nimi" required /></p>
    <p><input asp-for="Email" type="email" placeholder="E-post" required /></p>
    <button type="submit">Lisa</button>
    <a asp-action="Index" class="btn btn-light">Tagasi</a>
</form>

<html>
<head>
    <style>
            body {
                background: blue;
                color: lightblue;
            }
            button:hover {            
                background: cyan;
                color: blue;
                padding: 10px;
                border-radius: 5px;
            }

    </style>
</head>
</html>