@model ShopTARpe25.Models.Kindergarten.KindergartenCreateViewModel

<div>
    Kindergarten Create
</div>

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div>
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="GroupName" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ChildrenCount" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="KindergartenName" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="TeacherName" class="form-control" />
        </div>
    </div>


    <div>
        <label asp-for="Files" class="col-sm-2 col-form-label">Pildid</label>
        <div class="col-sm-10">
            <input asp-for="Files" class="form-control" type="file" multiple accept="image/*" />
        </div>
    </div>

    @foreach (var image in Model.Images)
    {
        <div class="my-2">
            <img src="~/multipleFileUpload/@image.FilePath" alt="Kindergarten pilt" style="max-width: 220px; max-height: 180px;" />
            <form asp-action="RemoveImage" asp-controller="Kindergarten" method="post">
                <input type="hidden" name="ImageId" value="@image.ImageId" />
                <input type="hidden" name="returnAction" value="Update" />
                <button type="submit" class="btn btn-danger btn-sm">Kustuta pilt</button>
            </form>
        </div>
    }

    <input asp-action="Create" asp-controller="Kindergarten" type="submit" class="btn btn-primary" value="Create" />
    <a asp-action="Index" asp-controller="Kindergarten" class="btn btn-secondary">Back to List</a>
</form>
