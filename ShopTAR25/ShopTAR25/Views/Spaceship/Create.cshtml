@model ShopTAR25.Models.Spaceship.SpaceshipCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<hr />

<div class="row">
    <div class="col-md-10">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group row mb-3">
                <label asp-for="Name" class="col-sm-2 col-form-label fw-semibold">
                    Name
                </label>

                <div class="col-sm-10">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="Classification" class="col-sm-2 col-form-label fw-semibold">
                    Classification
                </label>

                <div class="col-sm-10">
                    <input asp-for="Classification" class="form-control" />
                    <span asp-validation-for="Classification" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="BuiltDate" class="col-sm-2 col-form-label fw-semibold">
                    Built Date
                </label>

                <div class="col-sm-10">
                    <input asp-for="BuiltDate"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="BuiltDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="Crew" class="col-sm-2 col-form-label fw-semibold">
                    Crew
                </label>

                <div class="col-sm-10">
                    <input asp-for="Crew"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="Crew" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="EnginePower" class="col-sm-2 col-form-label fw-semibold">
                    Engine Power
                </label>

                <div class="col-sm-10">
                    <input asp-for="EnginePower"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="EnginePower" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="col-sm-2 col-form-label fw-semibold">
                    Files
                </label>

                <div class="col-sm-10">

                    <label for="fileUpload" class="file-upload">
                        <span>Choose File</span>
                        <span id="fileName">No file chosen</span>
                    </label>

                    <input type="file"
                           id="fileUpload"
                           name="Files"
                           multiple
                           hidden />

                </div>
            </div>

            <div class="mt-4">

                <input type="submit"
                       value="Create"
                       class="btn btn-success" />

                <a asp-action="Index"
                       class="btn btn-secondary">
                    Back
                </a>

            </div>

        </form>

    </div>
</div>

<style>
    .file-upload {
        display: flex;
        align-items: center;
        width: 100%;
        height: 38px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        background-color: white;
        cursor: pointer;
        overflow: hidden;
    }

        .file-upload span:first-child {
            background-color: #e9ecef;
            border-right: 1px solid #ced4da;
            padding: 8px 14px;
            color: #212529;
        }

    #fileName {
        padding-left: 12px;
        color: #6c757d;
    }
</style>

<script>
    document.getElementById("fileUpload").addEventListener("change", function () {

        const fileName = document.getElementById("fileName");

        if (this.files.length === 0) {

            fileName.textContent = "No file chosen";

        } else if (this.files.length === 1) {

            fileName.textContent = this.files[0].name;

        } else {

            fileName.textContent = this.files.length + " files chosen";

        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}